rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "K3zPRVF2kNOg1EApkkuJ61tihUQ2";
    }

    match /cupidSubmissions/{submissionId} {
      // Public visitors may create submissions only. No public reads, updates, or deletes.
      allow create: if request.resource.data.keys().hasOnly(['quizVersion', 'answers', 'consentGiven', 'createdAt'])
        && request.resource.data.keys().hasAll(['quizVersion', 'answers', 'consentGiven', 'createdAt'])
        && request.resource.data.quizVersion == 1
        && request.resource.data.consentGiven == true
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 20;

      // Only the one UID configured above can view, update, or delete responses.
      allow read, update, delete: if isAdmin();
    }
  }
}
